@startuml CarController

skinparam classAttributeIconSize 0

package org.springframework {
    package web.bind.annotation {
        annotation RestController
        annotation RequestMapping
        annotation PathVariable
        annotation RequestParam
        annotation ExceptionHandler
        annotation RestControllerAdvice
    }

    package http {
        class ResponseEntity<T>
        class ProblemDetail
    }
}

package java.util {
    interface Collection
    class UUID
}

package com.acme.rentcar {
    package entity {
        class Car
    }
    package service {
        class CarService << control >> << @Service >>

        ' Abhängigkeit vom Service zur Entity (nur visuell)
        CarService .right[hidden].> Car
    }

    package controller #DDDDDD {
        class CarController << boundary >> << @RestController >> << @RequestMapping >> {
            ~ @GetMapping getAll(): Collection<Car>
            ~ @GetMapping getById(@PathVariable id: UUID): Car
            ~ @GetMapping getByQuery(@RequestParam hersteller: String): Collection<Car>
        }

        class GlobalExceptionHandler << @RestControllerAdvice >> {
            ~ @ExceptionHandler onMethodArgumentNotValid(ex: MethodArgumentNotValidException): ProblemDetail
            ~ @ExceptionHandler onResponseStatus(ex: ResponseStatusException): ProblemDetail
        }

        ' Beziehungen
        CarController o--> "1" CarService : service

        ' Abhängigkeiten (Stereotypes/Annotationen)
        CarController .up.> RestController
        CarController .up.> RequestMapping
        CarController .up.> PathVariable
        CarController .up.> RequestParam
        CarController .up.> ResponseEntity

        ' Abhängigkeiten zu Datentypen
        CarController .down.> Car
        CarController .right.> UUID
        CarController ..> Collection

        ' Exception Handler Abhängigkeiten
        GlobalExceptionHandler .up.> RestControllerAdvice
        GlobalExceptionHandler .up.> ExceptionHandler
        GlobalExceptionHandler .up.> ProblemDetail
    }
}

hide empty members

footer (c) Juergen Zimmermann

@enduml
