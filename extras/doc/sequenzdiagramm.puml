@startuml sequenzdiagramm

skinparam classAttributeIconSize 0
skinparam componentStyle uml2

actor User
participant "Bruno / Client" as Client
participant ":CarController" as Controller << boundary >>
participant ":CarService" as Service << control >>
participant "carDto:CarDTO" as DTO << DTO >>
participant "newCar:Car" as Entity << entity >>
participant ":CarRepository" as Repository << control >>

User -> Client : POST /cars (JSON)
activate Client

Client -> Controller : createCar(carDto)
activate Controller

' Controller ruft Service
Controller -> Service : create(carDto)
activate Service

' Service erstellt die neue Entity (Mapping Logik)
create Entity
Service -> Entity : new()

' Service liest Werte aus dem DTO (Record Getter)
Service -> DTO : hersteller()
Service -> DTO : modell()
' ... weitere Getter ...

' Service setzt Werte in die Entity
Service -> Entity : setHersteller(...)
Service -> Entity : setModell(...)
note right: Manuelles Mapping\nim Service

' Speichern
Service -> Repository : save(newCar)
activate Repository
Repository --> Service : newCar
deactivate Repository

' Rückkehr zum Controller
Service --> Controller : newCar
deactivate Service

' Controller baut Response
Controller --> Client : 201 Created
note right: Location Header gesetzt
deactivate Controller

deactivate Client

@enduml
